<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ctts.mapper.ProjectMemberMapper">

    <!-- join_time 由 DEFAULT CURRENT_TIMESTAMP 生成，不出现在 INSERT 列表里。
         这一点必须和"显式写 null"区分开：真写 null 会撞 NOT NULL（errno 1048），
         而不写这一列才会让数据库默认值生效。 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO project_member (project_id, user_id)
        VALUES (#{projectId}, #{userId})
    </insert>

    <select id="selectByProjectId" resultType="com.ctts.entity.ProjectMember">
        SELECT id, project_id, user_id, join_time
        FROM project_member
        WHERE project_id = #{projectId}
          AND deleted = 0
        ORDER BY id
    </select>

    <!-- 判重与回查共用。返回单对象：唯一索引保证"未删除的成员里最多一条"。
         用 List 会让人以为存在多条、进而写出"取第一条"这种掩盖数据问题的代码。
         移出后再加入会插一行新的（旧行保留为历史），所以这里必须带 deleted = 0，
         否则已移出的学生会被误判成"还在项目里"。 -->
    <select id="selectByProjectAndUser" resultType="com.ctts.entity.ProjectMember">
        SELECT id, project_id, user_id, join_time
        FROM project_member
        WHERE project_id = #{projectId}
          AND user_id = #{userId}
          AND deleted = 0
    </select>

    <!-- 逻辑删除（移出成员）。deleted 写本行 id，
         唯一索引 (project_id, user_id, deleted) 因此允许"移出再加回来" -->
    <update id="softDeleteByProjectAndUser">
        UPDATE project_member
        SET deleted = id
        WHERE project_id = #{projectId}
          AND user_id = #{userId}
          AND deleted = 0
    </update>

</mapper>
