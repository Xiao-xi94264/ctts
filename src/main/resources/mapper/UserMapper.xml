<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ctts.mapper.UserMapper">

    <select id="selectById" resultType="com.ctts.enity.User">
        SELECT id, username, real_name, role
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultType="com.ctts.enity.User">
        SELECT id, username, real_name, role
        FROM sys_user
    </select>

</mapper>
